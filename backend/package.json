{
  "name": "@madrasa/backend",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS API + grammY bot + cron + BullMQ",
  "scripts": {
    "prisma:generate": "prisma generate --schema ../prisma/schema.prisma",
    "predev": "npm run prisma:generate",
    "dev": "nest start --watch",
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "prisma migrate deploy --schema ../prisma/schema.prisma && node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/serve-static": "^5.0.0",
    "@prisma/client": "^6.19.0",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "grammy": "^1.36.0",
    "ioredis": "^5.4.0",
    "multer": "^2.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "prisma": "^6.19.0",
    "typescript": "^5.7.0"
  }
}
