# ============================================================
#  Abdurahmon ibn Avf madrasasi — muhit o'zgaruvchilari
#  Nusxa oling:  cp .env.example .env
# ============================================================

# --- Umumiy ---
NODE_ENV=development
TZ_NAME=Asia/Bishkek
PORT=3000
# Backend ning tashqi manzili (fayllar, chek rasmlari, stream havolalari uchun)
PUBLIC_API_URL=http://localhost:3000

# --- Telegram bot ---
# @BotFather dan olingan token. Bo'sh bo'lsa, API bot'siz ishga tushadi.
BOT_TOKEN=
# Bot username (@ belgisiz) — admin login havolalari uchun
BOT_USERNAME=abdurahmon_madrasa_bot
# Webhook manzili (prod). Bo'sh bo'lsa long-polling ishlatiladi.
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=change-me-webhook-secret
# Admin Telegram ID lari, vergul bilan: 123456789,987654321
ADMIN_IDS=

# --- Ma'lumotlar bazasi va Redis ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/madrasa?schema=public
REDIS_URL=redis://localhost:6379

# --- Tunduk (KR davlat pasport tekshiruvi) ---
# Bo'sh bo'lsa MOCK ishlaydi: ID ichida "0000" bo'lsa — yaroqsiz, aks holda yaroqli.
TUNDUK_API_URL=
TUNDUK_API_KEY=

# --- To'lovlar va Hayriya ---
# Hayriya jamg'armasi MBank raqami (pul shu raqamga tushadi)
HAYRIYA_MBANK_NUMBER=+996700000000
HAYRIYA_RECIPIENT_NAME=Abdurahmon ibn Avf madrasasi
# Jamg'arma chegarasi (som). Yetganda admin tarqatadi va hisobot yuklaydi.
DONATION_LIMIT=20000

# --- Xavfsizlik ---
JWT_SECRET=change-me-very-long-random-string
# Faqat dev: Mini App ni brauzerda "Authorization: dev <telegramId>" bilan ochish
ALLOW_DEV_AUTH=true

# --- Frontend manzillari ---
MINIAPP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Vite ilovalar uchun (miniapp/admin) — build vaqtida o'qiladi
VITE_API_URL=http://localhost:3000
VITE_DEV_TELEGRAM_ID=
VITE_BOT_USERNAME=abdurahmon_madrasa_bot
